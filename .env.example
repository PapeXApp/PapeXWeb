# ImgBB API Key for Image Uploads
# Get your free API key from: https://api.imgbb.com/
NEXT_PUBLIC_IMGBB_API_KEY=your-imgbb-api-key-here

# Firebase Configuration (if needed)
# NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
# NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Vercel Blob Storage (optional, if using Vercel storage instead of ImgBB)
# BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# Merchant dashboard (merchant.papex.app, app/merchant/*).
# Base host for the RDH merchant read API — no trailing slash, no /merchant
# suffix (lib/merchantApi.ts appends the route paths itself). Public because
# calls happen client-side with a Firebase ID token attached as the
# Authorization header; the token, not this URL, is what's sensitive.
NEXT_PUBLIC_RDH_API_BASE=https://api.papex.app

# Set to "1" to serve lib/merchantMock.ts's synthetic dataset instead of
# calling NEXT_PUBLIC_RDH_API_BASE — lets the whole /merchant/* dashboard be
# built/demoed/QA'd with zero backend (M5 of the merchant-dashboard plan).
# Leave unset (or any value other than "1") once the real merchant-api
# Lambda (plan.md M2) is live.
NEXT_PUBLIC_MERCHANT_MOCK=1

# RDH "Save to PapeX" claim proxy (app/api/rdh/claim/route.ts).
# Host base only — no /api/v1 suffix, the route appends /api/v1/rdh/claim
# itself. Default below is derived from PapeXV2/config/api.ts's
# OCR_BASE_URL fallback (http://3.90.44.195:3000/api/v1) with the /api/v1
# suffix stripped. Server-side only — never exposed to the browser (no
# NEXT_PUBLIC_ prefix), since this points at the internal adapter backend.
ADAPTER_API_BASE=https://adapter.api.papex.app
